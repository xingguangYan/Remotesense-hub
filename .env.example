# 数据库：本地用 SQLite，生产换 Postgres（如 Neon/Supabase）
# Postgres 示例：postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL="file:./dev.db"

# 邮件服务（Resend），留空则进入开发模拟模式，邮件仅打印到控制台
RESEND_API_KEY=""

# 站点地址，用于生成验证链接与管理链接
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 商务合作邮箱（所有合作咨询转发到这里）
COOPERATION_EMAIL="xingguangyan0703@gmail.com"

# 发件人地址（Resend 需验证域名；测试可用 onboarding@resend.dev）
MAIL_FROM="RemoteSense Hub <onboarding@resend.dev>"

# token 哈希加盐，生产环境务必修改
TOKEN_SALT="change-me-in-production"
